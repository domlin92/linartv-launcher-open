<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- "Update" opens Android's own install window for a newer LinarTV from GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice search in the club/city search: asked only when the microphone button is pressed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Not required: projectors and boxes with plain Android (e.g. Wanbo T2 Max) have no leanback. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.canal.android.canal" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.tvp.vodtv.tv" />
    </queries>
    <application android:label="LinarTV Open" android:icon="@drawable/ic_linar_tv"
        android:banner="@drawable/banner_linar_tv"
        android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="true">
        <service android:name=".WakeService" android:exported="false" />
        <provider android:name=".UpdateFileProvider" android:authorities="${applicationId}.updates"
            android:exported="false" android:grantUriPermissions="true" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:name=".DashboardActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Icon in the app list of plain Android devices (projectors, boxes). -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets LinarTV be chosen as the default home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service android:name=".SpotifySessionListener" android:label="LinarTV · Spotify"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
